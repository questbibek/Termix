# Code-level R2 backups — config for the compose file.
# On the VPS, copy to /opt/termix/.env (which `docker compose` auto-loads),
# fill in, then `chmod 600 .env`. NEVER commit the filled-in version.

# Enable the in-app backup scheduler
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24     # how often to back up
BACKUP_KEEP_COUNT=15         # keep the newest N backups (by count, not days)

# Cloudflare R2 (Dashboard -> R2 -> Manage API Tokens -> Object Read & Write)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=termix-backups
R2_PREFIX=data-backups       # folder inside the bucket

# --- Registration control (see EMAIL_ALLOWLIST.md) ---
# Restrict self-signup to these email domains (comma-separated). Empty = open.
ALLOWED_EMAIL_DOMAINS=vrittechnologies.com

# --- SMTP for password reset + signup OTP (see EMAIL_SETUP.md) ---
# Leave SMTP_HOST empty to disable email (reset codes -> docker logs, no OTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@vrittechnologies.com
SMTP_PASS=your_app_password
SMTP_FROM=Termix <no-reply@vrittechnologies.com>
SMTP_SECURE=               # blank=auto (true on 465, STARTTLS otherwise)
SIGNUP_OTP_ENABLED=true    # require email verification at signup (needs SMTP)
